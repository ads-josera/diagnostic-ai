# =============================================================================
# Variables de entorno requeridas — Sales Leadership Diagnostic AI
# =============================================================================
# Este archivo es SOLO documentación. No contiene valores reales y sí se
# versiona en Git.
#
# Cada entorno mantiene sus PROPIOS valores; jamás se comparten entre
# development, staging y production (§49).
#
#   Desarrollo local  →  .ddev/config.local.yaml  (web_environment, ignorado)
#   Staging / Producción → variables de entorno del servidor
#
# El módulo las consume vía Settings::get() desde web/sites/default/settings.php.
# Si alguna falta, hook_requirements() lo reporta en /admin/reports/status y la
# funcionalidad afectada falla de forma cerrada (§13).
# =============================================================================

# -----------------------------------------------------------------------------
# SLD_JWT_SHARED_SECRET
# -----------------------------------------------------------------------------
# Secreto compartido para firmar y verificar el token SSO (HS256) que emite
# WordPress y consume Drupal. DEBE ser idéntico al del mu-plugin de WordPress.
# Generar con:  openssl rand -hex 32
SLD_JWT_SHARED_SECRET=

# -----------------------------------------------------------------------------
# SLD_WP_HMAC_SECRET
# -----------------------------------------------------------------------------
# Secreto compartido para firmar las llamadas Drupal → WordPress al endpoint de
# autorización (HMAC-SHA256). DEBE ser idéntico al del mu-plugin de WordPress.
# Debe ser DISTINTO de SLD_JWT_SHARED_SECRET: si uno se filtra, el otro sigue
# protegiendo su canal.
# Generar con:  openssl rand -hex 32
SLD_WP_HMAC_SECRET=

# -----------------------------------------------------------------------------
# SLD_OPENAI_API_KEY
# -----------------------------------------------------------------------------
# API key de OpenAI. Solo se usa desde el backend (§29). Nunca debe aparecer en
# JavaScript, HTML, URLs, cookies ni logs.
SLD_OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# DRUPAL_HASH_SALT
# -----------------------------------------------------------------------------
# Salt criptográfico de Drupal. En desarrollo lo provee DDEV automáticamente;
# en staging y producción es OBLIGATORIO definirlo aquí.
# Generar con:  openssl rand -hex 32
DRUPAL_HASH_SALT=

# -----------------------------------------------------------------------------
# DRUPAL_TRUSTED_HOST
# -----------------------------------------------------------------------------
# Expresión regular del host permitido, sin delimitadores. Obligatorio en
# producción para prevenir ataques de HTTP Host header.
# Ejemplo:  ^diagnostic\.salesbumm\.com$
DRUPAL_TRUSTED_HOST=
