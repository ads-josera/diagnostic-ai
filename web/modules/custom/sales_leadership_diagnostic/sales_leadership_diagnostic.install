<?php

/**
 * @file
 * Instalación y desinstalación del módulo Sales Leadership Diagnostic AI.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\file\FileInterface;
use Drupal\sales_leadership_diagnostic\SalesLeadershipDiagnostic;
use Drupal\user\Entity\Role;

/**
 * Implements hook_schema().
 *
 * Define la tabla de mensajes de la conversación.
 *
 * No son una entidad de contenido por privacidad: contienen información
 * empresarial sensible del alumno y como entidad quedarían expuestos a Views,
 * al índice de búsqueda y a cualquier módulo que recorra entidades. Fuera de
 * Entity API la única puerta de entrada es DiagnosticMessageRepository.
 *
 * Drupal crea y elimina esta tabla automáticamente al instalar y desinstalar.
 */
function sales_leadership_diagnostic_schema(): array {
  return [
    'sld_diagnostic_message' => [
      'description' => 'Mensajes de las conversaciones de diagnóstico.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'Identificador del mensaje.',
        ],
        'session_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'Sesión a la que pertenece.',
        ],
        'role' => [
          'type' => 'varchar',
          'length' => 16,
          'not null' => TRUE,
          'description' => 'Autor del mensaje: user o assistant.',
        ],
        'content' => [
          'type' => 'text',
          'size' => 'big',
          'not null' => TRUE,
          'description' => 'Texto del mensaje tal como se escribió o se recibió.',
        ],
        'payload' => [
          'type' => 'text',
          'size' => 'big',
          'not null' => FALSE,
          'description' => 'Turno estructurado completo en JSON. Nulo en los mensajes del alumno.',
        ],
        'sequence' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'Posición dentro de la conversación.',
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'Marca temporal de creación.',
        ],
      ],
      'primary key' => ['id'],
      'unique keys' => [
        // Sirve a la vez de índice de lectura del historial y de última
        // defensa contra turnos duplicados: si dos escrituras simultáneas
        // calcularan la misma secuencia, la segunda falla en lugar de
        // corromper el orden de la conversación en silencio.
        'session_sequence' => ['session_id', 'sequence'],
      ],
    ],
  ];
}

/**
 * Implements hook_install().
 *
 * Crea el rol de alumno mediante código y no mediante config/install de forma
 * deliberada.
 *
 * Al desinstalar un módulo, Drupal no borra los roles que dependen de él: la
 * clase Role::onDependencyRemoval() les retira los permisos pero conserva el
 * rol para no destruir las asignaciones a usuarios. Como consecuencia, un rol
 * declarado en config/install sobrevive a la desinstalación y hace que la
 * siguiente instalación aborte con PreExistingConfigException, dejando el
 * módulo imposible de reinstalar (§3).
 *
 * Crearlo aquí resuelve ambos extremos: la operación es idempotente, así que
 * también repara un rol huérfano de una instalación anterior devolviéndole su
 * permiso.
 */
function sales_leadership_diagnostic_install(): void {
  _sales_leadership_diagnostic_ensure_role(
    SalesLeadershipDiagnostic::STUDENT_ROLE_ID,
    SalesLeadershipDiagnostic::STUDENT_ROLE_LABEL,
    SalesLeadershipDiagnostic::PERMISSION_ACCESS,
    5,
  );

  // El rol de soporte se crea sin usuarios asignados. Sin él, el permiso de
  // leer diagnósticos ajenos solo podía concederse inventando un rol a mano, y
  // la vía cómoda —dar el rol de administrador a quien atiende soporte— le
  // habría entregado también el prompt y las credenciales de integración.
  _sales_leadership_diagnostic_ensure_role(
    SalesLeadershipDiagnostic::SUPPORT_ROLE_ID,
    SalesLeadershipDiagnostic::SUPPORT_ROLE_LABEL,
    SalesLeadershipDiagnostic::PERMISSION_VIEW_ALL_RESULTS,
    6,
  );

  // Rol de gestión del cliente. Es distinto del de soporte a propósito: hoy
  // llevan el mismo permiso, pero son puestos distintos y podrán separarse sin
  // reasignar usuarios. El tema de administración se le da para que el listado
  // de resultados no se pinte con el tema del alumno.
  _sales_leadership_diagnostic_ensure_role(
    SalesLeadershipDiagnostic::MANAGER_ROLE_ID,
    SalesLeadershipDiagnostic::MANAGER_ROLE_LABEL,
    SalesLeadershipDiagnostic::PERMISSION_VIEW_ALL_RESULTS,
    7,
    [SalesLeadershipDiagnostic::ADMIN_THEME_PERMISSION],
  );
}

/**
 * Crea un rol si no existe y le garantiza un permiso.
 *
 * Idempotente a propósito: también repara un rol huérfano de una instalación
 * anterior devolviéndole el permiso que la desinstalación le retiró.
 *
 * @param string $id
 *   Identificador del rol.
 * @param string $label
 *   Etiqueta visible.
 * @param string $permission
 *   Permiso que debe tener.
 * @param int $weight
 *   Peso en el listado de roles.
 * @param string[] $extra
 *   Permisos adicionales, si el rol necesita alguno de core.
 */
function _sales_leadership_diagnostic_ensure_role(string $id, string $label, string $permission, int $weight, array $extra = []): void {
  $role = Role::load($id);

  if ($role === NULL) {
    $role = Role::create([
      'id' => $id,
      'label' => $label,
      'weight' => $weight,
    ]);
  }

  $role->grantPermission($permission);

  foreach ($extra as $additional) {
    $role->grantPermission($additional);
  }

  $role->save();
}

/**
 * Implements hook_uninstall().
 *
 * Retira los permisos del módulo de los roles que crea y elimina cada rol
 * únicamente si ningún usuario lo tiene asignado.
 *
 * Borrar un rol que sigue asignado destruiría información irreversible, así
 * que en ese caso se conserva vacío y se deja la decisión al administrador.
 * Las cuentas provisionadas desde WordPress nunca se eliminan.
 */
function sales_leadership_diagnostic_uninstall(): void {
  $ids = [
    SalesLeadershipDiagnostic::STUDENT_ROLE_ID,
    SalesLeadershipDiagnostic::SUPPORT_ROLE_ID,
    SalesLeadershipDiagnostic::MANAGER_ROLE_ID,
  ];

  foreach ($ids as $id) {
    _sales_leadership_diagnostic_retire_role($id);
  }
}

/**
 * Deja un rol sin permisos del módulo, y lo borra si ya no lo usa nadie.
 *
 * @param string $id
 *   Identificador del rol.
 */
function _sales_leadership_diagnostic_retire_role(string $id): void {
  $role = Role::load($id);

  if ($role === NULL) {
    return;
  }

  foreach (SalesLeadershipDiagnostic::ALL_PERMISSIONS as $permission) {
    $role->revokePermission($permission);
  }

  $assigned = \Drupal::entityQuery('user')
    ->accessCheck(FALSE)
    ->condition('roles', $id)
    ->range(0, 1)
    ->execute();

  if ($assigned === []) {
    $role->delete();
    return;
  }

  $role->save();

  \Drupal::logger(SalesLeadershipDiagnostic::LOGGER_CHANNEL)->notice(
    'El rol %role se conserva porque sigue asignado a uno o más usuarios. Se le han retirado los permisos del módulo.',
    ['%role' => $id],
  );
}

/**
 * Añade el periodo de gracia de autorización.
 *
 * Sin este valor, una caída de WordPress denegaría el acceso a todos los
 * alumnos de inmediato, incluidos los que acababan de ser verificados. El
 * valor por defecto reutiliza una concesión reciente durante una hora; poner
 * cero desactiva la excepción y restaura el fail closed estricto (§13).
 */
function sales_leadership_diagnostic_update_10001(): string {
  $config = \Drupal::configFactory()->getEditable('sales_leadership_diagnostic.settings');

  if ($config->get('wordpress.cache_grace_period') === NULL) {
    $config->set('wordpress.cache_grace_period', 3600)->save();

    return 'Añadido el periodo de gracia de autorización con un valor de 3600 segundos.';
  }

  return 'El periodo de gracia ya estaba configurado; no se ha modificado.';
}

/**
 * Añade el catálogo de modelos de IA disponibles.
 *
 * Convierte el modelo de un campo de texto libre a una selección sobre una
 * lista administrada. Un identificador mal escrito solo se detectaba al
 * intentar generar un diagnóstico, con un error del proveedor difícil de
 * interpretar; con un catálogo, solo puede elegirse algo que ya se validó al
 * añadirlo.
 */
function sales_leadership_diagnostic_update_10002(): string {
  $config = \Drupal::configFactory()->getEditable('sales_leadership_diagnostic.settings');

  if ($config->get('openai.available_models') !== NULL) {
    return 'El catálogo de modelos ya existía; no se ha modificado.';
  }

  // Si ya había un modelo escrito a mano, se conserva y se incorpora al
  // catálogo para no perder la configuración existente.
  $current = trim((string) $config->get('openai.model'));

  $config
    ->set('openai.available_models', $current !== '' ? [$current] : [])
    ->save();

  return $current !== ''
    ? sprintf('Catálogo de modelos creado conservando el modelo configurado "%s".', $current)
    : 'Catálogo de modelos creado, vacío.';
}

/**
 * Añade el límite de tokens por respuesta del proveedor de IA.
 *
 * Los modelos con razonamiento consumen parte de este presupuesto antes de
 * empezar a escribir. Si se agota, la respuesta llega truncada y el JSON
 * queda incompleto: el diagnóstico falla con un error de formato cuya causa
 * real —presupuesto insuficiente— no es evidente. Por eso el valor es
 * configurable y su defecto es holgado.
 */
function sales_leadership_diagnostic_update_10003(): string {
  $config = \Drupal::configFactory()->getEditable('sales_leadership_diagnostic.settings');

  if ($config->get('openai.max_completion_tokens') !== NULL) {
    return 'El límite de tokens ya estaba configurado; no se ha modificado.';
  }

  $config->set('openai.max_completion_tokens', 2000)->save();

  return 'Añadido el límite de tokens por respuesta con un valor de 2000.';
}

/**
 * Crea el rol de soporte para las instalaciones anteriores.
 *
 * El permiso de leer diagnósticos ajenos existía desde el principio, pero no
 * había ningún rol que lo llevase ni ninguna página donde ejercerlo. Quien
 * quisiera dar soporte tenía que conceder el rol de administrador completo,
 * que además entrega el prompt y las credenciales de integración.
 *
 * El rol se crea vacío: no se asigna a nadie automáticamente.
 */
function sales_leadership_diagnostic_update_10004(): string {
  if (Role::load(SalesLeadershipDiagnostic::SUPPORT_ROLE_ID) !== NULL) {
    return 'El rol de soporte ya existía; no se ha modificado.';
  }

  _sales_leadership_diagnostic_ensure_role(
    SalesLeadershipDiagnostic::SUPPORT_ROLE_ID,
    SalesLeadershipDiagnostic::SUPPORT_ROLE_LABEL,
    SalesLeadershipDiagnostic::PERMISSION_VIEW_ALL_RESULTS,
    6,
  );

  return sprintf(
    'Creado el rol "%s" con permiso para consultar los diagnósticos de cualquier alumno. No se ha asignado a ningún usuario.',
    SalesLeadershipDiagnostic::SUPPORT_ROLE_LABEL,
  );
}

/**
 * Crea el rol Gestor SAM para las instalaciones existentes.
 *
 * Rol propio y NO un renombrado del de soporte: son puestos distintos en la
 * organización del cliente, y fundirlos habría impedido separar sus permisos
 * más adelante sin reasignar a las personas.
 *
 * Se crea vacío: el módulo no decide quién es gestor.
 */
function sales_leadership_diagnostic_update_10005(): string {
  if (Role::load(SalesLeadershipDiagnostic::MANAGER_ROLE_ID) !== NULL) {
    return 'El rol Gestor SAM ya existía; no se ha modificado.';
  }

  _sales_leadership_diagnostic_ensure_role(
    SalesLeadershipDiagnostic::MANAGER_ROLE_ID,
    SalesLeadershipDiagnostic::MANAGER_ROLE_LABEL,
    SalesLeadershipDiagnostic::PERMISSION_VIEW_ALL_RESULTS,
    7,
    [SalesLeadershipDiagnostic::ADMIN_THEME_PERMISSION],
  );

  return 'Creado el rol "Gestor SAM" con permiso para consultar los diagnósticos de cualquier alumno. No se ha asignado a ningún usuario.';
}

/**
 * Añade la marca de conversación de prueba a sesiones y resultados.
 *
 * Existe para que el gestor pueda ensayar el prompt con conversaciones reales
 * sin que esos ensayos aparezcan en el listado de resultados, cuenten para el
 * límite de diagnósticos por periodo, ni se confundan con datos de un alumno.
 *
 * Cuanto existiera antes de este cambio queda como NO prueba, que es lo
 * correcto: son diagnósticos reales de alumnos reales.
 */
function sales_leadership_diagnostic_update_10006(): string {
  $definition = BaseFieldDefinition::create('boolean')
    ->setLabel(new TranslatableMarkup('Conversación de prueba'))
    ->setDefaultValue(FALSE);

  $manager = \Drupal::entityDefinitionUpdateManager();
  $creados = [];

  foreach (['sld_diagnostic_session', 'sld_diagnostic_result'] as $tipo) {
    if ($manager->getFieldStorageDefinition('is_sandbox', $tipo) !== NULL) {
      continue;
    }

    $manager->installFieldStorageDefinition('is_sandbox', $tipo, 'sales_leadership_diagnostic', $definition);
    $creados[] = $tipo;
  }

  if ($creados === []) {
    return 'La marca de conversación de prueba ya existía; no se ha modificado nada.';
  }

  return sprintf('Añadida la marca de conversación de prueba a: %s.', implode(', ', $creados));
}

/**
 * Retira el logotipo de la pestaña «Marca».
 *
 * Desde que las páginas del alumno llevan el marco del diseño del cliente, el
 * logotipo lo pinta la barra superior, que se administra en «Portada». El de
 * «Marca» se dibujaba además dentro de la tarjeta, duplicando la marca en la
 * misma pantalla, y al retirarlo de la plantilla se quedó sin ningún sitio
 * donde mostrarse. Un ajuste que no se ve en ninguna parte invita a subir un
 * archivo y a preguntarse por qué no pasa nada.
 *
 * El archivo NO se borra. Solo se suelta el registro de uso que este módulo
 * había anotado sobre él: quien decida si un archivo sobra es el administrador
 * desde la gestión de archivos, no una actualización. Borrarlo aquí destruiría
 * algo que quizá se esté usando en otro sitio, y eso no se puede deshacer.
 */
function sales_leadership_diagnostic_update_10007(): string {
  $config = \Drupal::configFactory()->getEditable('sales_leadership_diagnostic.branding');
  $fid = (int) $config->get('logo_fid');

  if ($config->get('logo_fid') === NULL && $config->get('logo_alt') === NULL) {
    return 'El logotipo de Marca ya se había retirado; no se ha modificado nada.';
  }

  $config->clear('logo_fid')->clear('logo_alt')->save();

  if ($fid <= 0) {
    return 'Retirado el logotipo de la pestaña «Marca». No había ningún archivo configurado.';
  }

  $file = \Drupal::entityTypeManager()->getStorage('file')->load($fid);

  if (!$file instanceof FileInterface) {
    return sprintf(
      'Retirado el logotipo de la pestaña «Marca». El archivo %d ya no existía.',
      $fid,
    );
  }

  \Drupal::service('file.usage')->delete($file, 'sales_leadership_diagnostic', 'config', (string) $fid);

  return sprintf(
    'Retirado el logotipo de la pestaña «Marca». El archivo %d («%s») se conserva y queda sin uso registrado: bórralo desde la gestión de archivos si ya no hace falta.',
    $fid,
    $file->getFilename(),
  );
}

/**
 * Prepara la biblioteca de documentos de conocimiento del agente.
 *
 * El prompt del cliente declara que la metodología autorizada vive en esos
 * archivos, de modo que sin ellos el agente invoca un método que no puede
 * leer. La clave se crea vacía: los documentos los aporta el cliente desde
 * Contenido → Resultados → Documentos.
 */
function sales_leadership_diagnostic_update_10008(): string {
  $config = \Drupal::configFactory()->getEditable('sales_leadership_diagnostic.diagnostic');

  if ($config->get('knowledge_fids') !== NULL) {
    return 'La biblioteca de documentos ya existía; no se ha modificado.';
  }

  $config->set('knowledge_fids', [])->save();

  return 'Creada la biblioteca de documentos de conocimiento, vacía. Se cargan desde Contenido → Resultados → Documentos.';
}

/**
 * Convierte el agente único en el primer agente administrable.
 *
 * Hasta ahora el módulo tenía UN agente, definido en el objeto de
 * configuración `sales_leadership_diagnostic.diagnostic`. El cliente pidió
 * poder tener varios —un curso, un agente— así que el agente pasa a ser una
 * entidad de configuración de la que puede haber tantas como haga falta.
 *
 * Esta actualización NO borra la configuración antigua. Se copia, y el objeto
 * original se conserva: si algo saliera mal, la metodología del cliente sigue
 * donde estaba. Retirarlo es una limpieza posterior y deliberada, no un efecto
 * secundario de migrar.
 *
 * El curso lo hereda de `wordpress.course_id`, que era el único que había.
 */
function sales_leadership_diagnostic_update_10009(): string {
  $almacen = \Drupal::entityTypeManager()->getStorage('sld_agent');

  if ($almacen->load(SalesLeadershipDiagnostic::FIRST_AGENT_ID) !== NULL) {
    return 'El agente ya estaba migrado; no se ha modificado nada.';
  }

  $viejo = \Drupal::config('sales_leadership_diagnostic.diagnostic');
  $ajustes = \Drupal::config('sales_leadership_diagnostic.settings');

  $agente = $almacen->create([
    'id' => SalesLeadershipDiagnostic::FIRST_AGENT_ID,
    'label' => 'Sales Leadership Diagnostic AI',
    'status' => TRUE,
    'weight' => 0,
    'version' => (string) $viejo->get('version'),
    'course_id' => (string) $ajustes->get('wordpress.course_id'),
    'description' => 'Diagnóstico de madurez comercial B2B. Primer agente del producto.',
    'system_prompt' => (string) $viejo->get('system_prompt'),
    'instructions' => (string) $viejo->get('instructions'),
    'output_contract' => (string) $viejo->get('output_contract'),
    'knowledge_fids' => $viejo->get('knowledge_fids') ?? [],
    'welcome_icon_fid' => (int) $viejo->get('welcome_icon_fid'),
    'welcome_intro' => (string) $viejo->get('welcome_intro'),
    'welcome_suggestions' => $viejo->get('welcome_suggestions') ?? [],
  ]);

  $agente->save();

  return sprintf(
    'Creado el agente "%s" (%s) a partir de la configuración existente: versión %s, curso %s, %d documento(s) de conocimiento. La configuración antigua se conserva intacta.',
    $agente->label(),
    $agente->id(),
    $agente->getVersion() !== '' ? $agente->getVersion() : '(sin versión)',
    $agente->getCourseId() !== '' ? $agente->getCourseId() : '(sin curso)',
    count($agente->getKnowledgeFids()),
  );
}

/**
 * Anota en cada sesión y resultado con qué agente se hicieron.
 *
 * Hasta ahora solo había un agente y la pregunta no tenía sentido. Con varios,
 * un historial que no dice cuál se usó es ambiguo: dos diagnósticos de la
 * misma fecha pueden ser de metodologías distintas.
 *
 * No se deduce del curso a posteriori. El curso que concede un agente puede
 * cambiar, y entonces el historial empezaría a mentir sobre conversaciones ya
 * cerradas. Se anota una vez y se queda.
 *
 * Lo anterior a este cambio se atribuye al primer agente, que es lo cierto:
 * era el único que existía.
 */
function sales_leadership_diagnostic_update_10010(): string {
  $definicion = BaseFieldDefinition::create('string')
    ->setLabel(new TranslatableMarkup('Agente'))
    ->setSetting('max_length', 64);

  $manager = \Drupal::entityDefinitionUpdateManager();
  $creados = [];

  foreach (['sld_diagnostic_session', 'sld_diagnostic_result'] as $tipo) {
    if ($manager->getFieldStorageDefinition('agent', $tipo) !== NULL) {
      continue;
    }

    $manager->installFieldStorageDefinition('agent', $tipo, 'sales_leadership_diagnostic', $definicion);
    $creados[] = $tipo;
  }

  if ($creados === []) {
    return 'El campo del agente ya existía; no se ha modificado nada.';
  }

  // Se rellena lo existente con el primer agente. Se hace por consulta directa
  // y no cargando entidades: son datos de historial, no hay lógica que
  // ejecutar, y cargar miles de entidades para escribir un literal sería
  // gastar memoria sin ganar nada.
  $conexion = \Drupal::database();
  $tocadas = 0;

  foreach ($creados as $tipo) {
    $tocadas += $conexion->update($tipo)
      ->fields(['agent' => SalesLeadershipDiagnostic::FIRST_AGENT_ID])
      ->isNull('agent')
      ->execute();
  }

  return sprintf(
    'Añadido el campo del agente a: %s. Se han atribuido %d fila(s) al agente "%s", que era el único que existía.',
    implode(', ', $creados),
    $tocadas,
    SalesLeadershipDiagnostic::FIRST_AGENT_ID,
  );
}

/**
 * Crea el almacén de la memoria del alumno.
 *
 * Empieza vacío a propósito. La memoria se escribe al terminar un
 * diagnóstico, a partir de la conversación, y las conversaciones anteriores a
 * este cambio ya se cerraron: rellenarla a posteriori exigiría volver a
 * pasarlas por el modelo, con su coste y su margen de error, para producir
 * hechos que nadie ha revisado. Quien vuelva a diagnosticar la estrenará.
 */
function sales_leadership_diagnostic_update_10011(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  if ($manager->getEntityType('sld_student_memory') !== NULL) {
    return 'El almacén de la memoria ya existía; no se ha modificado nada.';
  }

  $tipo = \Drupal::entityTypeManager()->getDefinition('sld_student_memory');
  $manager->installEntityType($tipo);

  return 'Creado el almacén de la memoria del alumno, vacío. Se irá llenando a medida que se terminen diagnósticos.';
}

/**
 * Retira la configuración del agente único, que ya no gobierna nada.
 *
 * `sales_leadership_diagnostic.diagnostic` fue la definición del agente cuando
 * solo había uno. Al pasar a varios, `update_10009` copió su contenido a la
 * primera entidad de agente y desde entonces el diagnóstico se conduce con
 * ellas, pero el objeto se quedó ahí, y tres pantallas de administración
 * seguían escribiendo en él. Eso lo convirtió en una trampa: quien editaba el
 * prompt allí lo guardaba sin que pasara nada.
 *
 * Las tres pantallas se migraron el 26-08-2026. Esto retira lo que sostenían.
 *
 * El icono de la bienvenida necesita cuidado aparte: es un archivo real, y su
 * uso quedó registrado a nombre de la configuración. Se libera aquí para que
 * el recuento no apunte a algo que ya no existe. El archivo NO se borra: lo
 * usa ahora el agente, que registra su propio uso al guardarse.
 */
function sales_leadership_diagnostic_update_10012(): string {
  $config = \Drupal::configFactory()->getEditable('sales_leadership_diagnostic.diagnostic');

  if ($config->isNew()) {
    return 'La configuración del agente único ya no existía; no se ha modificado nada.';
  }

  $liberados = 0;
  $fid = (int) $config->get('welcome_icon_fid');

  if ($fid > 0) {
    $archivo = \Drupal::entityTypeManager()->getStorage('file')->load($fid);

    if ($archivo !== NULL) {
      // El tipo 'config' es el que usaba el formulario retirado.
      \Drupal::service('file.usage')->delete($archivo, 'sales_leadership_diagnostic', 'config', (string) $fid);
      $liberados = 1;
    }
  }

  $config->delete();

  // El borrador del estudio también era único y pasó a ser por agente.
  \Drupal::state()->delete('sales_leadership_diagnostic.prompt_draft');

  return sprintf(
    'Retirada la configuración del agente único. Archivos liberados: %d. El contenido vive en las entidades de agente desde update_10009.',
    $liberados,
  );
}

/**
 * Crea el plazo de conservación de las conversaciones, que faltaba.
 *
 * El ajuste se añadió el 26-08-2026 al archivo de instalación del módulo, y
 * eso solo alcanza a las instalaciones NUEVAS: en un sitio donde el módulo ya
 * estaba instalado la clave nunca llegó a existir. Se detectó el 29-08 al
 * consultarla y encontrarse con que no estaba.
 *
 * No era peligroso —una clave ausente se lee como cero, que significa no
 * purgar nada— pero sí engañoso: el formulario habría dejado fijar un plazo
 * que la configuración exportada nunca tuvo, y en producción el ajuste no
 * habría existido.
 *
 * Se crea en CERO, que es conservar indefinidamente. Actualizar el módulo no
 * debe empezar a borrar datos de nadie: activarlo es una decisión que alguien
 * tiene que tomar a sabiendas.
 */
function sales_leadership_diagnostic_update_10013(): string {
  $config = \Drupal::configFactory()->getEditable('sales_leadership_diagnostic.settings');

  if ($config->get('diagnostic.conversation_retention_days') !== NULL) {
    return 'El plazo de conservación ya existía; no se ha modificado nada.';
  }

  $config->set('diagnostic.conversation_retention_days', 0)->save();

  return 'Creado el plazo de conservación de las conversaciones, en 0 (no se purga nada). Se fija en Configuración → Salesbumm → Diagnostic AI → Reglas de uso.';
}
