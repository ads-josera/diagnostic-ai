{#
/**
 * @file
 * Panel del alumno (§37).
 *
 * Desde que el panel comparte el marco de la portada
 * (page--sales-diagnostic-dashboard.html.twig), Drupal ya no imprime el
 * título de la ruta: esa plantilla, igual que la del inicio de sesión, solo
 * pone `page.content` dentro de la tarjeta. El saludo es entonces el único
 * encabezado de la página y se marca como `<h1>` por eso, no por estética.
 *
 * Aquí no se pinta ningún logotipo: lo pone la barra superior del marco, que
 * se administra en la pestaña «Portada». El que había dentro de la tarjeta
 * duplicaba la marca en la misma pantalla.
 *
 * Variables disponibles:
 * - user_name: nombre para el saludo.
 * - welcome_text: mensaje de bienvenida personalizado, o nulo.
 * - can_start: si puede iniciarse un diagnóstico ahora mismo.
 * - start_url: destino del formulario de inicio, con su token CSRF.
 * - resume_session_id: identificador de la sesión a medias, o nulo.
 * - repeat_notice: aviso sobre la política de repetición, o nulo.
 * - unavailable_notice: motivo, si no puede. Un alumno recibe un mensaje
 *   neutro; un administrador, el detalle técnico.
 * - history: filas del historial, cada una con id, date, status,
 *   status_machine, version, result_id e is_resumable.
 *
 * Twig autoescapa todas las variables, de modo que ningún dato de usuario
 * puede inyectar marcado.
 */
#}
<div class="sld sld-dashboard">

  <header class="sld-dashboard__header">
    <h1 class="sld-dashboard__greeting">{{ 'Bienvenido, @name'|t({'@name': user_name}) }}</h1>

    {# Texto plano: Twig lo escapa. No se admite marcado a propósito. #}
    {% if welcome_text %}
      <p class="sld-dashboard__welcome">{{ welcome_text }}</p>
    {% endif %}
  </header>

  {% if expiry_notice %}
    <div class="sld__notice sld__notice--warning" role="status">
      <p>{{ expiry_notice.message }}</p>
    </div>
  {% endif %}

  {% if unavailable_notice %}
    <div class="sld__notice sld__notice--warning" role="status">
      <p>{{ unavailable_notice.message }}</p>
      {% if unavailable_notice.details is not empty %}
        <ul>
          {% for detail in unavailable_notice.details %}
            <li>{{ detail }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endif %}

  <div class="sld-dashboard__start">
    {% if can_start %}
      {#
        Un formulario y no un enlace: iniciar un diagnóstico crea una sesión, y
        con GET la crearía cualquier cosa que precargue enlaces. El token CSRF
        impide además que otro sitio lo dispare desde el navegador del alumno.

        Toda la política se aplica en el servidor, en DiagnosticStarter. Este
        botón solo evita ofrecer algo que se va a rechazar; no es la defensa.
      #}
      <form action="{{ start_url }}" method="post">
        <button type="submit" class="sld__button">
          {{ resume_session_id ? 'Continuar mi diagnóstico'|t : 'Iniciar diagnóstico'|t }}
        </button>
      </form>

      {% if repeat_notice %}
        <p class="sld__muted">{{ repeat_notice }}</p>
      {% endif %}
    {% else %}
      <button type="button" class="sld__button" aria-disabled="true" disabled>
        {{ 'Iniciar diagnóstico'|t }}
      </button>
    {% endif %}
  </div>

  <section aria-labelledby="sld-history-title">
    <h2 class="sld-dashboard__section-title" id="sld-history-title">
      {{ 'Mis diagnósticos'|t }}
    </h2>

    {% if history is empty %}
      <p class="sld-dashboard__empty">
        {{ 'Todavía no has realizado ningún diagnóstico.'|t }}
      </p>
    {% else %}
      <div class="sld-dashboard__table-wrapper">
        <table class="sld-dashboard__table">
          <thead>
            <tr>
              <th scope="col">{{ 'Fecha'|t }}</th>
              <th scope="col">{{ 'Estado'|t }}</th>
              <th scope="col">{{ 'Versión'|t }}</th>
              <th scope="col">
                <span class="sld__visually-hidden">{{ 'Acciones'|t }}</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {% for row in history %}
              <tr>
                <td data-label="{{ 'Fecha'|t }}">{{ row.date }}</td>
                <td data-label="{{ 'Estado'|t }}">
                  <span class="sld-status sld-status--{{ row.status_machine }}">
                    {{ row.status }}
                  </span>
                </td>
                <td data-label="{{ 'Versión'|t }}">{{ row.version }}</td>
                <td data-label="{{ 'Acciones'|t }}">
                  {% if row.result_id %}
                    <a class="sld__link" href="{{ path('sales_leadership_diagnostic.result', {'sld_diagnostic_result': row.result_id}) }}">
                      {{ 'Ver resultado'|t }}
                    </a>
                  {% elseif row.is_resumable %}
                    <a class="sld__link" href="{{ path('sales_leadership_diagnostic.session', {'sld_diagnostic_session': row.id}) }}">
                      {{ 'Continuar'|t }}
                    </a>
                  {% else %}
                    <span class="sld__muted">—</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </section>

</div>
