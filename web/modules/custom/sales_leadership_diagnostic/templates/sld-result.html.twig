{#
/**
 * @file
 * Resultado de un diagnóstico completado (§35).
 *
 * Variables:
 * - title: encabezado de la página. Lo imprime esta plantilla porque el marco
 *   interno no pinta la región donde el tema coloca su bloque de título; sin
 *   él la página se quedaba sin `<h1>`.
 * - summary: resumen ya saneado. Es Markup, así que Twig no vuelve a escaparlo.
 * - score: puntuación, o null si la metodología no contempla ninguna.
 * - maturity: banda de madurez global, o cadena vacía.
 * - confidence: confianza global, o cadena vacía.
 * - dimensions: puntuación por dimensión, cada una con name, score, max,
 *   level y confidence. Vacía en los diagnósticos anteriores al 26-08-2026,
 *   que no la guardaban.
 * - sections: lista de secciones con label e items.
 * - version: versión del diagnóstico con la que se generó.
 * - created: fecha de generación.
 *
 * Los elementos de las listas son texto plano y Twig los escapa. Proceden del
 * motor de IA y no se tratan como marcado.
 */
#}
<div class="sld sld-result">

  <header class="sld-result__header">
    <h1 class="sld-result__title">{{ title }}</h1>

    <p class="sld-result__meta">
      {{ 'Generado el @date'|t({'@date': created}) }}
      <span class="sld-result__version">{{ 'versión @v'|t({'@v': version}) }}</span>
    </p>
  </header>

  {% if score is not null %}
    <section class="sld-result__score" aria-labelledby="sld-score-label">
      <h2 class="sld-result__section-title" id="sld-score-label">
        {{ 'Puntuación de madurez comercial'|t }}
      </h2>
      <div class="sld-score">
        <div class="sld-score__value">{{ score }}<span class="sld-score__max">/100</span></div>
        {% if maturity or confidence %}
          <p class="sld-score__band">
            {% if maturity %}<strong>{{ maturity }}</strong>{% endif %}
            {% if confidence %}
              <span class="sld-score__confidence">{{ 'Confianza: @c'|t({'@c': confidence}) }}</span>
            {% endif %}
          </p>
        {% endif %}
        {#
          El indicador es decorativo: el valor ya está escrito arriba en texto,
          de modo que quien no vea la barra no pierde información.
        #}
        <div class="sld-score__bar" aria-hidden="true">
          <div class="sld-score__fill" style="width: {{ score }}%"></div>
        </div>
      </div>
    </section>
  {% endif %}

  {#
    Madurez por dimensión.

    Es el corazón de la metodología del cliente y hasta el 26-08-2026 solo
    existía dentro de la conversación, en prosa. Se pinta como tabla porque son
    datos tabulares: un lector de pantalla la recorre por filas y columnas.

    Los diagnósticos anteriores no la traen y la sección simplemente no
    aparece, igual que antes.
  #}
  {% if dimensions is not empty %}
    <section class="sld-result__section" aria-labelledby="sld-dimensiones">
      <h2 class="sld-result__section-title" id="sld-dimensiones">
        {{ 'Madurez por dimensión'|t }}
      </h2>

      <div class="sld-result__table-wrapper">
        <table class="sld-dimensions">
          <thead>
            <tr>
              <th scope="col">{{ 'Dimensión'|t }}</th>
              <th scope="col">{{ 'Puntuación'|t }}</th>
              <th scope="col">{{ 'Nivel'|t }}</th>
              <th scope="col">{{ 'Confianza'|t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for d in dimensions %}
              <tr>
                <th scope="row" class="sld-dimensions__name">{{ d.name }}</th>
                <td data-label="{{ 'Puntuación'|t }}">
                  <span class="sld-dimensions__score">{{ d.score }}<span class="sld-dimensions__max">/{{ d.max }}</span></span>
                  {# La barra es decorativa: la cifra ya está al lado. #}
                  <span class="sld-dimensions__bar" aria-hidden="true">
                    <span class="sld-dimensions__fill" style="width: {{ (d.score / d.max * 100)|round }}%"></span>
                  </span>
                </td>
                <td data-label="{{ 'Nivel'|t }}">{{ d.level }}</td>
                <td data-label="{{ 'Confianza'|t }}">{{ d.confidence }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}

  {% if summary %}
    <section class="sld-result__summary" aria-labelledby="sld-summary-label">
      <h2 class="sld-result__section-title" id="sld-summary-label">{{ 'Resumen'|t }}</h2>
      <div class="sld-result__prose">{{ summary }}</div>
    </section>
  {% endif %}

  {% if accounts is not empty %}
    <section class="sld-pack" aria-labelledby="sld-pack-label">
      <div class="sld-pack__head">
        <h2 class="sld-result__section-title" id="sld-pack-label">{{ 'Cuentas del Pack'|t }}</h2>
        {% if pool %}
          <p class="sld-pack__pool">
            {{ 'Cribadas @n cuentas'|t({'@n': pool.audited}) }}
            {% if pool.claimed %}
              <span class="sld-pack__discrepancy">
                {{ 'el agente declaró @n; solo estas se pueden auditar'|t({'@n': pool.claimed}) }}
              </span>
            {% endif %}
          </p>
        {% endif %}
      </div>

      <ol class="sld-pack__list">
        {% for a in accounts %}
          <li class="sld-pack__account">
            <div class="sld-pack__bar sld-pack__bar--{{ a.outreach_status|lower|default('sin') }}" aria-hidden="true"></div>

            <div class="sld-pack__body">
              <div class="sld-pack__title-row">
                {% if a.rank %}<span class="sld-pack__rank">{{ a.rank }}</span>{% endif %}
                <h3 class="sld-pack__name">{{ a.name }}</h3>
                {% if a.disposition %}
                  <span class="sld-pack__chip sld-pack__chip--{{ a.disposition|lower }}">{{ a.disposition }}</span>
                {% endif %}
                {% if a.outreach_status %}
                  <span class="sld-pack__status sld-pack__status--{{ a.outreach_status|lower }}">
                    {%- if a.outreach_status == 'RELEASED' -%}{{ 'Se puede enviar'|t }}
                    {%- elseif a.outreach_status == 'PREPARED' -%}{{ 'Mensaje listo, falta comprobar'|t }}
                    {%- else -%}{{ 'Bloqueada'|t }}{%- endif -%}
                  </span>
                {% endif %}
              </div>

              {% if a.outreach_status == 'BLOCKED' and a.blocked_reason %}
                <p class="sld-pack__blocked">{{ a.blocked_reason }}</p>
              {% endif %}

              <dl class="sld-pack__fields">
                {% if a.why_now %}
                  <dt>{{ 'Por qué ahora'|t }}</dt>
                  <dd>
                    {{ a.why_now }}
                    {% if a.sources is not empty %}
                      <ul class="sld-pack__sources">
                        {% for s in a.sources %}
                          <li>
                            <a href="{{ s.url }}" rel="noopener noreferrer" target="_blank">{{ s.label }}</a>
                            {% if s.published %}<span class="sld-pack__date">{{ s.published }}</span>{% endif %}
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </dd>
                {% endif %}

                {% if a.gap_hypothesis %}
                  <dt>{{ 'Hipótesis GAP'|t }}</dt>
                  <dd>{{ a.gap_hypothesis }}</dd>
                {% endif %}

                {% if a.competing_alternative %}
                  <dt>{{ 'La alternativa que compite'|t }}</dt>
                  <dd class="sld-pack__alt">{{ a.competing_alternative }}</dd>
                {% endif %}

                {% if a.buyer %}
                  <dt>{{ 'Buyer'|t }}</dt>
                  <dd>
                    {{ a.buyer }}
                    <span class="sld-pack__verified sld-pack__verified--{{ a.buyer_verified ? 'si' : 'no' }}">
                      {{ a.buyer_verified ? 'verificado'|t : 'sin verificar'|t }}
                    </span>
                  </dd>
                {% endif %}

                {% if a.routing %}
                  <dt>{{ 'Routing'|t }}</dt>
                  <dd>{{ a.routing }}</dd>
                {% endif %}

                {% if a.next_step %}
                  <dt>{{ 'Siguiente paso'|t }}</dt>
                  <dd>{{ a.next_step }}</dd>
                {% endif %}
              </dl>

              {% if a.do_not_claim is not empty %}
                <div class="sld-pack__warn">
                  <p class="sld-pack__warn-title">{{ 'Qué NO afirmar'|t }}</p>
                  <ul>
                    {% for d in a.do_not_claim %}<li>{{ d }}</li>{% endfor %}
                  </ul>
                </div>
              {% endif %}

              {% if a.outreach_message %}
                <div class="sld-pack__message">
                  <div class="sld-pack__message-head">
                    <span>{{ 'Mensaje preparado'|t }}</span>
                    <button type="button" class="sld-pack__copy" data-sld-copy>{{ 'Copiar'|t }}</button>
                  </div>
                  <pre class="sld-pack__message-body">{{ a.outreach_message }}</pre>
                </div>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </section>
  {% endif %}

  {% for section in sections %}
    <section class="sld-result__section" aria-labelledby="sld-sec-{{ section.key }}">
      <h2 class="sld-result__section-title" id="sld-sec-{{ section.key }}">
        {{ section.label }}
      </h2>
      <ul class="sld-result__list sld-result__list--{{ section.key }}">
        {% for item in section.items %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}

  {% if sections is empty and not summary %}
    <div class="sld__notice" role="status">
      <p>{{ 'Este diagnóstico no tiene contenido que mostrar.'|t }}</p>
    </div>
  {% endif %}

  <footer class="sld-result__footer">
    {#
      El destino depende de quién mira: el alumno vuelve a su panel y el gestor
      al listado del que vino. Antes llevaba SIEMPRE al panel del alumno, así
      que el gestor acababa en una pantalla que no es suya, sin sus pestañas.
    #}
    <a class="sld__button sld__button--secondary" href="{{ back.url }}">
      {{ back.label }}
    </a>
    <p class="sld__muted sld-result__disclaimer">
      {{ 'Este análisis se ha generado a partir de tus respuestas durante la conversación.'|t }}
    </p>
  </footer>

</div>
